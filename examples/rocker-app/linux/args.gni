import("//build_overrides/chip.gni")

# Import args from chip
import("${chip_root}/config/standalone/args.gni")

chip_device_project_config_include = "<CHIPProjectAppConfig.h>"
chip_project_config_include = "<CHIPProjectAppConfig.h>"
chip_system_project_config_include = "<SystemProjectConfig.h>"

chip_project_config_include_dirs =
    [ "${chip_root}/examples/rocker-app/linux/include" ]
chip_project_config_include_dirs += [ "${chip_root}/config/standalone" ]

# Rocker app specific configuration
chip_examples_enable_imgui_ui = true

# Cluster configuration is handled by ZAP files
# All cluster enables are managed through the ZAP file

# Enable PW RPC for debugging
chip_enable_pw_rpc = false

# Disable BLE support (IP-only commissioning)
chip_config_network_layer_ble = false
