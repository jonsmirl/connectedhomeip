import("//build_overrides/chip.gni")
import("${chip_root}/src/app/chip_data_model.gni")
import("${chip_root}/src/app/icd/icd.gni")

config("config") {
  include_dirs = [ "include" ]
}

chip_data_model("keypad-common") {
  zap_file = "keypad-app.zap"
  is_server = true
}

source_set("keypad-manager") {
  deps = [
    ":keypad-common",
    "${chip_root}/src/lib",
    "${chip_root}/src/app/clusters/lowpan-ble-sensor-server",
    "${chip_root}/src/app/clusters/mode-base-server",
  ]
  public_configs = [ ":config" ]
  sources = [
    "include/KeypadDeviceInfoProvider.h",
    "include/KeypadManager.h",
    "include/KeypadModeSelect.h",
    "src/CustomClusterCallbacks.cpp",
    "src/KeypadDeviceInfoProvider.cpp",
    "src/KeypadManager.cpp",
    "src/KeypadModeSelect.cpp",
    "src/ZclCallbacks.cpp",
    "${chip_root}/src/app/clusters/mode-base-server/mode-base-server.cpp",
    "${chip_root}/src/app/clusters/mode-base-server/mode-base-cluster-objects.cpp",
  ]
}
