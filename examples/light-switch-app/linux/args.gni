import("//build_overrides/chip.gni")

import("${chip_root}/config/standalone/args.gni")

chip_device_project_config_include = "<CHIPProjectAppConfig.h>"
chip_project_config_include = "<CHIPProjectAppConfig.h>"
chip_system_project_config_include = "<SystemProjectConfig.h>"

chip_project_config_include_dirs =
    [ "${chip_root}/examples/light-switch-app/linux/include" ]
chip_project_config_include_dirs += [ "${chip_root}/config/standalone" ]

# Enable ImGui UI by default for the light-switch-app
chip_examples_enable_imgui_ui = true

# Enable client clusters for light switch functionality
chip_enable_client_clusters = true

# Enable binding cluster for device targeting
chip_enable_binding_cluster = true

# Enable the necessary client clusters
chip_enable_on_off_client = true
chip_enable_level_control_client = true
chip_enable_color_control_client = true
chip_enable_scenes_client = true
chip_enable_identify_client = true

# Enable commissioning and discovery
chip_enable_commissioning = true
chip_enable_discovery = true

# Enable operational credentials for device communication
chip_enable_operational_credentials = true

# Enable group communication
chip_enable_group_messaging = true

# Disable BLE support (IP-only commissioning)
chip_config_network_layer_ble = false
